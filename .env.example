# Academic Horizon Backend — Environment Variables
# Copy this file to .env.development.local or .env.production.local

# ─── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development # or 'production'

# ─── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/academic_horizon?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d # e.g., 7d, 24h, 1h

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://yourdomain.com

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000      # 15 minutes in milliseconds
RATE_LIMIT_MAX=100              # Global: max requests per window
AUTH_RATE_LIMIT_MAX=10          # Auth endpoints: stricter limit

# ─── File Uploads ─────────────────────────────────────────────
MAX_FILE_SIZE=10485760          # 10MB in bytes
UPLOAD_DIR=uploads              # Directory for uploaded files

# ─── Provider Settings ────────────────────────────────────────
PROVIDER_EMAIL_DOMAIN=@academic.com  # Only providers can use this email domain

# ─── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=الأفق الأكاديمي <onboarding@resend.dev>
FRONTEND_URL=http://localhost:5173

# ─── Wallet / commission ──────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=15

# ─── Security ─────────────────────────────────────────────────
# Arcjet/WAF settings
ARCJET_ENABLED=true
ARCJET_MODE=block                # 'block' or 'monitor'
